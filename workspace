#!/bin/bash
# Launch Windows Terminal workspace: 3 tabs × 2 panes (vertical split), all Ubuntu/WSL
# Uses a .cmd tempfile to avoid bash/wt.exe escaping issues across WSL interop

CMDFILE=$(mktemp /tmp/workspace.XXXXXX.cmd)
cat > "$CMDFILE" << 'BATCH'
@echo off
rem Portable: use the stable "WSL" profile and the default distro (no -d),
rem so this works regardless of distro name / Store package version.
set P=WSL
set HUB=~/pyprojects/guppy_hub
set BASE=~/pyprojects

wt.exe -w new -p "%P%" -- wsl.exe --cd %HUB% -e bash -lic claude ; split-pane -V -p "%P%" -- wsl.exe --cd %HUB% ; new-tab -p "%P%" -- wsl.exe --cd %BASE% ; split-pane -V -p "%P%" -- wsl.exe --cd %BASE% ; new-tab -p "%P%" -- wsl.exe --cd %BASE% ; split-pane -V -p "%P%" -- wsl.exe --cd %BASE% ; focus-tab -t 0
BATCH

WINPATH=$(wslpath -w "$CMDFILE")
cmd.exe /c "$WINPATH" 2>/dev/null
rm -f "$CMDFILE"
